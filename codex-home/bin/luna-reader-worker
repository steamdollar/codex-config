#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'Usage: %s [--cwd PATH] PROMPT\n' "$0" >&2
}

cwd=$PWD
if [[ ${1:-} == --cwd ]]; then
  (($# >= 3)) || { usage; exit 2; }
  cwd=$2
  shift 2
fi

(($# == 1)) || { usage; exit 2; }
[[ -d "$cwd" ]] || fail "working directory does not exist: $cwd"

codex_bin=${CODEX_READER_BIN:-codex}
command -v "$codex_bin" >/dev/null 2>&1 || fail "Codex CLI not found: $codex_bin"

codex_home=${CODEX_HOME:-$HOME/.codex}
sessions_dir="$codex_home/sessions"
log_file=$(mktemp "${TMPDIR:-/tmp}/luna-reader-worker.XXXXXX.jsonl")
trap 'rm -f -- "$log_file"' EXIT

worker_prompt=$(printf '%s\n\nTask:\n%s' \
  'Act as a bounded read-only worker. Do not edit files, make final decisions, contact the user, or spawn another agent. Return only concise findings, evidence paths or lines, and unknowns.' \
  "$1")

if ! "$codex_bin" \
  --ask-for-approval never \
  --model gpt-5.6-luna \
  --config model_reasoning_effort=medium \
  --sandbox read-only \
  --cd "$cwd" \
  exec --json --skip-git-repo-check "$worker_prompt" >"$log_file"; then
  sed -n '1,200p' "$log_file" >&2
  fail 'Luna reader process failed'
fi

python3 - "$log_file" "$sessions_dir" <<'PY'
import json
import pathlib
import sys

log_path = pathlib.Path(sys.argv[1])
sessions_dir = pathlib.Path(sys.argv[2])
thread_id = None
final_message = None

with log_path.open(encoding="utf-8") as stream:
    for raw_line in stream:
        try:
            event = json.loads(raw_line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "thread.started":
            thread_id = event.get("thread_id")
        item = event.get("item", {})
        if event.get("type") == "item.completed" and item.get("type") == "agent_message":
            final_message = item.get("text")

if not thread_id:
    raise SystemExit("ERROR: Luna reader thread id was not returned")

matches = sorted(sessions_dir.rglob(f"*-{thread_id}.jsonl"))
if not matches:
    raise SystemExit(f"ERROR: Luna reader transcript not found for {thread_id}")

transcript = matches[-1]
actual_model = None
with transcript.open(encoding="utf-8") as stream:
    for raw_line in stream:
        try:
            record = json.loads(raw_line)
        except json.JSONDecodeError:
            continue
        if record.get("type") == "turn_context":
            actual_model = record.get("payload", {}).get("model")
            break

if actual_model != "gpt-5.6-luna":
    raise SystemExit(
        f"ERROR: Luna model attestation failed: expected gpt-5.6-luna, got {actual_model!r}"
    )
if final_message is None:
    raise SystemExit("ERROR: Luna reader returned no final message")

print(final_message)
print(
    f"ATTESTED model={actual_model} transcript={transcript}",
    file=sys.stderr,
)
PY
