prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["git", "merge", "--ff-only"], decision="allow")
prefix_rule(pattern=["git", "stash", "pop"], decision="allow")
prefix_rule(pattern=["git", "stash", "push", "-m", "codex-sync-approved-rules", "--", "codex-home/rules/default.rules"], decision="allow")
prefix_rule(pattern=["git", "stash", "push", "-u", "-m", "codex-sync-2026-08-24"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "git stash pop stash@{1}"], decision="allow")
prefix_rule(pattern=["git", "commit", "-am", "Refine agent orchestration and audit rules"], decision="allow")
prefix_rule(pattern=["git", "fetch", "origin", "main"], decision="allow")
prefix_rule(pattern=["git", "push", "origin", "main"], decision="allow")
